NEXT_PUBLIC_SANITY_PROJECT_ID=lli7g5ge
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=https://www.domecekjanov.cz

# Mapa výletů (sekce "Výlety po okolí").
# Klíč z https://developer.mapy.com - v projektu musí být povolené funkce
# "Mapové dlaždice" a "Plánování tras", jinak API vrací 403.
#
# NEXT_PUBLIC_ verze jde do prohlížeče a načítá turistické dlaždice (mapset outdoor).
# Omez ji v administraci Mapy.com na doménu webu.
# Když klíč chybí, mapa se vykreslí z OpenStreetMap + Waymarked Trails.
NEXT_PUBLIC_MAPY_API_KEY=

# Serverová verze téhož klíče. Používá ji jen `npm run build:routes`, který
# předpočítá geometrii tras profilem foot_hiking do src/data/trip-routes.json.
# Bez klíče skript spočítá trasy přes BRouter (hiking-beta nad OSM daty).
MAPY_API_KEY=

# Editační režim (web/?edit). Zapne se, jen když jsou vyplněné všechny tři
# proměnné naráz - jinak celé API odpovídá 404. Žádná z nich nesmí být
# NEXT_PUBLIC_, do prohlížeče nepatří.
#
# PIN, kterým se klient přihlásí. Míň než 6 znaků režim nezapne.
EDIT_PIN=
# Klíč pro podpis přihlašovací cookie, aspoň 32 znaků: `openssl rand -hex 32`.
# Jeho změnou se odhlásí všichni přihlášení.
EDIT_SECRET=
# Token Sanity s rolí Editor. Bez něj by nebylo kam ukládat.
SANITY_API_WRITE_TOKEN=
